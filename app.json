{
  "expo": {
    "name": "Tulla",
    "slug": "tulla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tulla",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.alastairrmcneill.tulla",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.alastairrmcneill.tulla",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "alastair-mcneill",
          "project": "tulla"
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79c6886e-e171-4800-a97d-2313255403a3"
      }
    },
    "owner": "alastair.r.mcneill"
  }
}
